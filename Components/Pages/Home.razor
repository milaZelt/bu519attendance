@page "/"

@using attendance.Components.Models
@using attendance.Services
@inject BlazorNonceService BlazorNonceService
@inject AttendanceNotifier AttendanceNotifier
@implements IDisposable

<PageTitle>Daily attendance for @selectedDate</PageTitle>

@if (!showButtons)
{
    <h1>Unauthorized</h1>
    <p>You are not authorized to view this page.</p>
    <p>Logged in as: @principalName</p>
}
else
{
    <h4 class="attendance-heading">Daily attendance for:
        <select @onchange="OnDateChanged">
            <option value="">Select a date</option>
            @foreach (var date in availableDates)
            {
                <option value="@date.ToString("MMMddyyyy")">@date.ToString("MMMM dd, yyyy")</option>
            }
        </select>
        <button @onclick="() => UpdateAttendanceAsync()">Save</button>
        @if (showStudents)
        {
            <span class="attendance-count" aria-live="polite">@AttendanceCount / @TotalStudentCount in attendance</span>
        }
    </h4>

    @if (loading || saving)
    {
        <div
            style="height: 85px; width: 300px; background-color: bisque; border: solid 4px black; z-index: 5; position: absolute; left: 300px; top: 200px;">
            @if (loading)
            {
                <span>Loading...</span>
            }
            else if (saving)
            {
                <span>Saving...</span>
            }
        </div>
    }

    @if (showStudents)
    {
        <div class="students">
            @{
                int studentnumber = 0;
            }
            @for (int i = 0; i < 4; i++)
            {
                @for (int j = 0; j < 8; j++, studentnumber++)
                {
                    if ( studentnumber >= students.Count)
                    {
                        break;
                    }
                    if (students[studentnumber].IsInactive)
                    {
                        continue;
                    }

                    var localStudentNumber = studentnumber; // Create a local copy of studentnumber
                    var status = students[studentnumber].Present ? "present" : "absent";
                    var deco = students[studentnumber].Present ? "style=\"border: 5px solid green\"" : "";
                    <div class="student @status" @onclick="() => TogglePresent(localStudentNumber)">
                        <img src="https://studentinfo.blob.core.windows.net/@(classname)/@(students[studentnumber].BUID).jpg" width="90"
                            height="90" style="@(students[studentnumber].Present ? "border: 5px solid green" : "");" />
                        <div class="studentinfo">
                            @students[studentnumber].Name
                            <br />
                            @students[studentnumber].BUID
                            @if (students[studentnumber].Present)
                            {
                                <div class="exempt" @onclick:stopPropagation @onclick="() => ToggleExempt(localStudentNumber)">
                                    <input type="checkbox" checked="@students[studentnumber].Exempt" />
                                    Exempt
                                </div>
                            }
                        </div>
                    </div>
                    if (studentnumber == students.Count - 1)
                    {
                        break;
                    }
                }
                if (studentnumber == students.Count - 1)
                {
                    break;
                }
            }
        </div>
    }
}


@code {

    private string selectedDate = string.Empty;
    private string status = "";
    private string classname = string.Empty;
    private StudentClass? studentClass;
    private bool loading = false;
    private bool saving = false;
    private bool showButtons = false;
    private bool showStudents = false;
    private string principalName = "foo";

    // make a static list of dates based on the schedule
    private List<DateTime> availableDates = new List<DateTime>();

    // Live updates: identifies this page so it ignores its own broadcasts
    private readonly Guid pageId = Guid.NewGuid();
    private string LiveKey => AttendanceNotifier.Key(classname, selectedDate);

    List<Student> students = new List<Student>();

    private int AttendanceCount => students.Count(student => student.Present && !student.IsInactive);
    private int TotalStudentCount => students.Count(student => !student.IsInactive);

    protected override async Task OnInitializedAsync()
    {
        AttendanceNotifier.Changed += OnChangedElsewhere;

        classname = Environment.GetEnvironmentVariable("CLASSFOLDER") ?? "Classes";
        principalName = BlazorNonceService?.Nonce ?? string.Empty; 
        studentClass = new StudentClass(classname);

        var tempClassName = studentClass.lookupClassName(principalName).FirstOrDefault() ?? string.Empty;
        if (!string.IsNullOrEmpty(tempClassName))
        {
            classname = tempClassName;
            showButtons = true;

            availableDates.Clear();
            if (studentClass.scheduledDates.Count > 0)
            {
                foreach (var day in studentClass.scheduledDates)
                {
                    availableDates.Add(day.ToDateTime(new TimeOnly(0, 0)));
                }
            }
            else 
            {
                DateTime startDate = new DateTime(2025, 1, 27);
                for (int i = 0; i < 13; i++) // Generate dates for one year
                {
                    availableDates.Add(startDate.AddDays(i * 7));
                }
            }

            // Set the default date to the closest date in the list
            selectedDate = availableDates.OrderBy(x => Math.Abs((x - DateTime.Now).TotalDays)).First().ToString("yyyy-MM-dd");
            loading = true;

            students = await studentClass.LoadStudentsAsync();
            // sort by name
            students = students.OrderBy(x => x.Name).ToList();
            loading = false;

            StateHasChanged();
        }        
    }

    <!-- private void GenerateAvailableDates(string classname)
    {
        availableDates.Clear();
        var days = studentClass.getSchedule(classname);
        if (days.Count > 0)
        {
            foreach (var day in days)
            {
                availableDates.Add(day.ToDateTime(new TimeOnly(0, 0)));
            }
            return;
        }


        DateTime startDate = new DateTime(2025, 1, 27);
        for (int i = 0; i < 13; i++) // Generate dates for one year
        {
            availableDates.Add(startDate.AddDays(i * 7));
        }
    } -->

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (e?.Value == null) 
        {
            selectedDate = availableDates.Count > 0 ? availableDates[0].ToString("MMMddyyyy") : string.Empty;
        }
        else 
        {
            selectedDate = e.Value.ToString() ?? string.Empty;
        }

        if (string.IsNullOrEmpty(selectedDate))
        {
            showStudents = false;
            return;
        }

        //Console.WriteLine($"Selected date: {e.Value} {selectedDate}");
        loading = true;
        showStudents = false;
        //StateHasChanged();
        if (studentClass != null)
        {
            students = await studentClass.LoadStudentDataAsync(selectedDate);
            status = studentClass.status;

            // Show changes others have made but not saved yet
            foreach (var change in AttendanceNotifier.GetUnsaved(LiveKey))
            {
                ApplyChange(change);
            }
        }
        loading = false;
        showStudents = true;
        //StateHasChanged();
    }

    // Save student attence data to blob storage
    private async Task UpdateAttendanceAsync()
    {
        if (studentClass == null) return;
        
        saving = true;
        StateHasChanged();
        studentClass.Students = students;
        if (await studentClass.SaveStudentDataAsync(selectedDate))
        {
            AttendanceNotifier.ClearUnsaved(LiveKey);
        }
        saving = false;
        status = studentClass.status;
        StateHasChanged();
    }

    async Task TogglePresent(int index)
    {
        students[index].Present = !students[index].Present;
        StateHasChanged(); // Ensure the UI is updated
        await PublishAsync(students[index]);
    }
    async Task ToggleExempt(int index)
    {
        students[index].Exempt = !students[index].Exempt;
        StateHasChanged(); // Ensure the UI is updated
        await PublishAsync(students[index]);
    }

    private Task PublishAsync(Student s) => AttendanceNotifier.PublishAsync(LiveKey,
        new StudentData { BUID = s.BUID, Present = s.Present, Exempt = s.Exempt }, pageId);

    private void ApplyChange(StudentData change)
    {
        var student = students.FirstOrDefault(x => x.BUID == change.BUID);
        if (student != null)
        {
            student.Present = change.Present;
            student.Exempt = change.Exempt;
        }
    }

    // Another page changed a student: show it here if this page has the same class and date open.
    // InvokeAsync runs the update on this page's own thread.
    private Task OnChangedElsewhere(string key, StudentData change, Guid sourceId)
    {
        if (sourceId == pageId) return Task.CompletedTask;
        return InvokeAsync(() =>
        {
            if (!showStudents || key != LiveKey) return;
            ApplyChange(change);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AttendanceNotifier.Changed -= OnChangedElsewhere;
    }

}